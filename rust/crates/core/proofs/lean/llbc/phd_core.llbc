cComment":""},{"DocComment":" # Invariants"},{"DocComment":""},{"DocComment":" For any `a`, `n`, and `m`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::backward(Step::backward(a, n), m) == Step::backward(a, n + m)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::backward_checked(a, n) == Some(Step::backward(a, n))`"},{"DocComment":" * `Step::backward(a, n) == (0..n).fold(a, |x, _| Step::backward(x, 1))`"},{"DocComment":"   * Corollary: `Step::backward(a, 0) == a`"},{"DocComment":" * `Step::backward(a, n) <= a`"},{"DocComment":" * `Step::forward(Step::backward(a, n), n) == a`"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":1169}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1169},{"Deduplicated":681}],"output":{"Deduplicated":1169}},"src":{"TraitDefault":{"trait_ref":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":1169}],"const_generics":[],"trait_refs":[]}},"item_id":7}},"body":"Opaque"},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["range",0]},{"Ident":["Step",0]},{"Ident":["backward_unchecked",0]}],"span":{"data":{"file_id":4,"beg":{"line":237,"col":4},"end":{"line":237,"col":67}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the value that would be obtained by taking the *predecessor*"},{"DocComment":" of `self` `count` times."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" It is undefined behavior for this operation to overflow the"},{"DocComment":" range of values supported by `Self`. If you cannot guarantee that this"},{"DocComment":" will not overflow, use `backward` or `backward_checked` instead."},{"DocComment":""},{"DocComment":" # Invariants"},{"DocComment":""},{"DocComment":" For any `a`:"},{"DocComment":""},{"DocComment":" * if there exists `b` such that `b < a`, it is safe to call `Step::backward_unchecked(a, 1)`"},{"DocComment":" * if there exists `b`, `n` such that `steps_between(&b, &a) == (n, Some(n))`,"},{"DocComment":"   it is safe to call `Step::backward_unchecked(a, m)` for any `m <= n`."},{"DocComment":"   * Corollary: `Step::backward_unchecked(a, 0)` is always safe."},{"DocComment":""},{"DocComment":" For any `a` and `n`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::backward_unchecked(a, n)` is equivalent to `Step::backward(a, n)`"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":1169}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1169},{"Deduplicated":681}],"output":{"Deduplicated":1169}},"src":{"TraitDefault":{"trait_ref":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":1169}],"const_generics":[],"trait_refs":[]}},"item_id":8}},"body":"Opaque"},null,null,null,null,{"def_id":14,"item